  <property name="styleSheet">
   <string notr="true">/*===========================================
MainWindow - Menü ile Uyumlu Arkaplan
===========================================*/
#MainWindow {
    background-color: rgb(40, 50, 80);
}

/*===========================================
Menü Aç/Kapa Butonu
===========================================*/
#pButtonChange {
    padding: 5px;
    border: none;
    width: 30px;
    height: 30px;
}

/*===========================================
Sadece İkonlu Yan Menü (widgetIcons) - Değişiklik Yok
===========================================*/
#widgetIcons {
    background-color: rgb(24, 30, 54);
    width: 50px;
    border-radius: 8px; /* Kenar yumuşatma */
}
/* İkon ve logo yüksekliği */
#widgetIcons QPushButton {
    height: 50px;
    border: none;
}

/* İkon buton hover &amp; seçildiğinde */
#widgetIcons QPushButton:hover {
    background-color: rgba(86, 101, 115, 0.5);
}
#widgetIcons QPushButton:checked {
    background-color: rgba(26, 188, 156, 0.1);
}

/*===========================================
İkon+Yazılı Yan Menü (widgetMenu) - Değişiklik Yok
===========================================*/
#widgetMenu {
    background-color: rgb(24, 30, 54);
    border-radius: 8px;
    /* genişlik otomatik, içerik girince ayarlanır */
}
/* Menü içi butonların genel stili */
#widgetMenu QPushButton {
    border: none;
    border-radius: 3px;
    text-align: left;
    padding: 8px 0 8px 15px;
    color: #788596;
    font-weight: 500; /* biraz kalın temelde */
}

/* Menü buton hover */
#widgetMenu QPushButton:hover {
    background-color: rgba(86, 101, 115, 0.5);
    color: #ffffff;
}

/* Seçili (checked) menü butonuna accent bar, renk ve bold */
#widgetMenu QPushButton:checked {
    border-left: 4px solid #ffffff;
    background-color: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    font-weight: bold;
}

/*===========================================
StackedWidget - Eski Ölçüler, Yeni Renk
===========================================*/
#stackedWidget {
    background-color: rgb(243, 244, 245);
    border-radius: 8px; /* 8px ile hafif yuvarlatma */
    padding: 5px;
}

/*===========================================
Ortak Diğer Öğeler - Eski Ölçüler, Yeni Renk
===========================================*/
/* Varsayılan &quot;widget&quot; id'li header/footer vs. */
#widget {
    background-color: rgb(248, 250, 252);
}

/*===========================================
Form Elemanları - Eski Ölçüler Korundu
===========================================*/
QComboBox {
    background-color: rgb(248, 250, 252);
    border: 2px solid rgb(200, 210, 220);
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 14px;
    color: rgb(50, 65, 85);
    min-height: 20px;
}

QComboBox:hover {
    border-color: rgb(180, 190, 200);
    background-color: rgb(255, 255, 255);
}

QComboBox:focus {
    border-color: rgb(100, 110, 140);
    outline: none;
}

QComboBox::drop-down {
    border: none;
    background: transparent;
    width: 25px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid rgb(100, 116, 139);
    margin-right: 8px;
}

QPushButton {
    background-color: rgb(24, 30, 54);
    color: rgb(255, 255, 255);
    border: 1px solid rgb(60, 70, 100);
    border-radius: 6px;
    padding: 10px 20px;
    font-weight: 500;
    font-size: 14px;
}

QPushButton:hover {
    background-color: rgb(35, 45, 75);
    border-color: rgb(70, 80, 110);
}

QPushButton:pressed {
    background-color: rgb(20, 25, 45);
    border-color: rgb(50, 60, 90);
}

QLabel[class=&quot;label_7&quot;]{
    color: rgb(255, 255, 255);
    font-weight: bold;
    font-size: 18px;
}
#label_7{
    color: rgb(255, 255, 255);
    font-weight: bold;
    font-size: 22px;
    qproperty-alignment: AlignCenter;
}

/*===========================================
Text Input Elemanları
===========================================*/
QTextEdit, QPlainTextEdit {
    background-color: rgb(248, 250, 252);
    border: 1px solid rgb(200, 210, 220);
    border-radius: 6px;
    color: rgb(50, 65, 85);
    padding: 8px;
    font-size: 14px;
}

QTextEdit:focus, QPlainTextEdit:focus {
    border-color: rgb(100, 110, 140);
    outline: none;
}

QLineEdit {
    background-color: rgb(248, 250, 252);
    border: 2px solid rgb(200, 210, 220);
    border-radius: 6px;
    color: rgb(50, 65, 85);
    padding: 8px 12px;
    font-size: 14px;
}

QLineEdit:hover {
    border-color: rgb(180, 190, 200);
}

QLineEdit:focus {
    border-color: rgb(100, 110, 140);
    outline: none;
}

/*===========================================
Scrollbar
===========================================*/
QScrollBar:vertical {
    background: rgb(240, 242, 245);
    width: 8px;
    border-radius: 4px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: rgb(180, 190, 200);
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: rgb(160, 170, 180);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

/*===========================================
Kesif Gorevi
===========================================*/
/* Kamera görüntü alanı 
#stackedWidgetKamera {
    background-color: black; 
    border: 2px solid rgb(200,210,220);
    border-radius: 6px;
}*/

/* Tarama progress bar */
#progressBarTarama {
    border: 2px solid rgb(200,210,220);
    border-radius: 6px;
    background-color: rgb(248,250,252);
    text-align: center;
    padding: 0px;
    min-height: 20px;

    /* tüm metni kalın ve siyah yap */
    font-weight: bold;
    color: black;
}

/* Dolu kısmın rengi */
#progressBarTarama::chunk {
    border-radius: 6px;
    background-color: rgb(26,188,156);
}
</string>
